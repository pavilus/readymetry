# ─────────────────────────────────────────────────────────────────────────────
# Readymetry — Environment Variables
# Copy this file to .env.local and fill in your real values.
# .env.local is gitignored and must NEVER be committed to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase (get from: supabase.com → project → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# App URL (used for redirects and metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000
