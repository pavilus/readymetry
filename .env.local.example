# ─────────────────────────────────────────────────────────────────────────────
# Readymetry — Environment Variables
# Copy this file to .env.local and fill in your real values.
# .env.local is gitignored and must NEVER be committed to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase (get from: supabase.com → project → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App URL (used for redirects and metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (keep secret values server-side; never prefix them with NEXT_PUBLIC_)
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
STRIPE_SINGLE_EXAM_PRICE_ID=price_your-single-exam-price
STRIPE_READINESS_PACK_PRICE_ID=price_your-readiness-pack-price
STRIPE_WORKFORCE_5_PRICE_ID=price_your-workforce-5-price
STRIPE_WORKFORCE_10_PRICE_ID=price_your-workforce-10-price
STRIPE_WORKFORCE_25_PRICE_ID=price_your-workforce-25-price

# Operational readiness
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key
SUPABASE_CUSTOM_SMTP_ENABLED=true
ERROR_MONITOR_WEBHOOK_URL=https://your-monitor.example/events
# Optional bearer credential for the monitoring ingestion endpoint
ERROR_MONITOR_BEARER_TOKEN=
